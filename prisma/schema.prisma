generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}


model User {
  id         String  @id @default(uuid())
  firstName  String
  lastName   String?
  email      String  @unique
  password   String
  isVerified Boolean @default(false)
}